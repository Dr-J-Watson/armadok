# Names only: copy to .env and fill in. Never commit .env.

# Folder holding the database and other state (a volume in production).
ARMADOK_DATA_DIR=

# Send the refresh cookie over HTTPS only. Set to "false" only for local development over HTTP.
ARMADOK_COOKIE_SECURE=

# Key that encrypts secrets in the database (needed for two-factor authentication).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARMADOK_ENCRYPTION_KEY=

# --- worker (docker-compose.worker.example.yml) ---
# Hub public key and one-time token, shown when you enrol a worker.
ARMADOK_HUB_KEY=
ARMADOK_ENROL_TOKEN=
# Group id that owns the Docker socket on the worker machine.
DOCKER_GID=

# Folder with the built web interface (set by the image; leave empty in development).
ARMADOK_WEB_DIR=
# Folder holding your Compose projects on the worker machine, and a group id allowed to write to it.
PROJECTS_DIR=
PROJECTS_GID=
# Traefik dynamic configuration folder on the worker machine (optional, see the worker compose).
TRAEFIK_DYNAMIC_DIR=

# Let notification channels reach private/loopback addresses (for example an ntfy server on your LAN).
# Leave empty or "false" unless you need it: it lets users make the hub call internal services.
ARMADOK_ALLOW_PRIVATE_OUTBOUND=

# Manage the hub's own machine as a node, with no worker ("true" to enable). See the compose example.
ARMADOK_LOCAL_NODE=

# Most records of one OVH zone Armadok will read (default 500, at most 5000). Reading a zone costs one
# OVH request per record, so large zones are slow and use your OVH API quota.
ARMADOK_DNS_MAX_RECORDS=
